{
    "project_name": "My Data Science Project",
    "project_slug": "{{ cookiecutter.project_name.lower().replace(' ', '_').replace('-', '_') }}",
    "project_description": "A data science project",
    "author_name": "Your Name",
    "author_email": "your.email@example.com",
    "python_version": "3.12",
    "environment_manager": ["pip", "uv", "conda", "pixi"],

    "include_latex_reports": false,
    "include_jupyter_notebooks": true,
    "include_r_scripts": false,
    "include_stata_scripts": false,
    "include_chartbook": true,
    "include_github_actions": false,

    "include_fred": false,
    "include_fed_yield_curve": false,
    "include_ofr_api": false,
    "include_bloomberg": false,
    "include_crsp_stock": false,
    "include_crsp_compustat": false,

    "_chartbook_version": "0.2.0",

    "__prompts__": {
        "project_name": "Project name, the site's title",
        "project_slug": "Folder name, from the project name (Enter keeps it)",
        "project_description": "One-line description",
        "author_name": "Your name",
        "author_email": "Your email",
        "python_version": "Python version",
        "environment_manager": {
            "__prompt__": "How to install the dependencies",
            "pip": "pip: a .venv and requirements.txt",
            "uv": "uv: pyproject.toml",
            "conda": "conda: environment.yml",
            "pixi": "pixi: pixi.toml"
        },
        "include_latex_reports": "LaTeX reports and slides (needs TeX installed)",
        "include_jupyter_notebooks": "An example notebook, shown on the site",
        "include_r_scripts": "R examples (needs conda or pixi)",
        "include_stata_scripts": "A Stata example (needs Stata)",
        "include_chartbook": "A ChartBook site: chartbook.toml and docs_src/ (keep yes)",
        "include_github_actions": "A GitHub Actions workflow that runs the tests and chartbook check",
        "include_fred": "Data from FRED (downloaded)",
        "include_fed_yield_curve": "The Fed's yield curve (downloaded)",
        "include_ofr_api": "Data from the OFR API (downloaded; with FRED, adds a chart)",
        "include_bloomberg": "Data from Bloomberg (needs a Bloomberg Terminal)",
        "include_crsp_stock": "CRSP stock data (needs a WRDS account)",
        "include_crsp_compustat": "CRSP-Compustat data (needs a WRDS account)"
    },

    "_copy_without_render": [
        "*.bst",
        "*.sty",
        "*.eps",
        "*.ipe",
        "*.png",
        "*.pdf",
        "*.tex",
        "*.bib",
        ".github/workflows/*.yml",
        ".claude/skills/*/*.md"
    ]
}

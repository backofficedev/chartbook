# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory. 

WRDS_USERNAME=jdoe
{%- if cookiecutter.include_r_scripts or cookiecutter.include_stata_scripts %}

# The R and Stata examples read these directories from .env. Python does not
# need them here: src/settings.py falls back to the same defaults. Relative
# paths are relative to the project root.
DATA_DIR=_data
OUTPUT_DIR=_output
{%- endif %}
